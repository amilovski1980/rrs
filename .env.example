# Copier en .env et compléter
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Inscription. 0 (défaut) : le cockpit est créé dès la confirmation de la société.
# 1 : exige le lien email. Le SMS reste inactif tant qu'un fournisseur n'est pas
# branché dans accounts/verification.py (send_phone_verification).
SIGNUP_VERIFICATION_ENABLED=0
# DATABASE_URL=postgres://user:pass@localhost:5432/roadrunner

# API Sirene INSEE (https://api.insee.fr/api-sirene/3.11)
INSEE_API_KEY=
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=
# INSEE_TOKEN=

# Autres intégrations
INPI_TOKEN=
API_ENTREPRISE_TOKEN=

# Connecteur e-mail comptable (Gmail OAuth2)
# Console Google Cloud : activer l'API Gmail, créer un client OAuth "Web",
# ajouter l'URI de redirection : https://votre-domaine/mail/callback/gmail/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Recommandé : clé Fernet dédiée (openssl rand -base64 32).
# Vide = dérivée de DJANGO_SECRET_KEY (changer la clé exige de reconnecter Gmail).
MAILSYNC_ENCRYPTION_KEY=

# Import d'historique (mobile)
HISTORY_IMPORT_MAX_FILES=200
HISTORY_IMPORT_MAX_FILE_MB=15
HISTORY_IMPORT_MAX_BATCH_MB=150
HISTORY_IMPORT_MAX_ZIP_FILES=100
HISTORY_IMPORT_MAX_ZIP_MB=150

# Agent vocal Grok (https://docs.x.ai/docs/guides/voice/agent)
# La clé n'est jamais envoyée au navigateur.
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve

# LLM AminiA self-hosté (vLLM)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-32b-awq
LLM_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Compte staff créé au démarrage. Le mot de passe n'est posé que si le compte
# n'en a pas encore : un mot de passe choisi ensuite n'est pas écrasé.
# ADMIN_EMAIL=admin@roadrunner-solutions.fr
# ADMIN_PASSWORD=

# Email (prod)
DEFAULT_FROM_EMAIL=no-reply@roadrunner-solutions.fr
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
