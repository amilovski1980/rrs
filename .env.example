# Copier en .env et compléter
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/roadrunner

# API Sirene INSEE (https://api.insee.fr/api-sirene/3.11)
INSEE_API_KEY=
INSEE_CLIENT_ID=
INSEE_CLIENT_SECRET=
# INSEE_TOKEN=

# Autres intégrations
INPI_TOKEN=
API_ENTREPRISE_TOKEN=

# LLM AminiAself-hosté (vLLM)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-32b-awq
LLM_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (prod)
DEFAULT_FROM_EMAIL=no-reply@roadrunner-solutions.fr
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
