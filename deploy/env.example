# Environnement de PRODUCTION (VPS) — recopier vers /srv/rrs/app/.env
# Ne jamais committer le fichier .env rempli.

SECRET_KEY=remplacer-par-une-cle-longue-aleatoire
DEBUG=0
ALLOWED_HOSTS=mondomaine.fr,www.mondomaine.fr
CSRF_TRUSTED_ORIGINS=https://mondomaine.fr,https://www.mondomaine.fr

# Postgres local
DATABASE_URL=postgres://rrs:MOT_DE_PASSE_FORT@127.0.0.1:5432/rrs

# Agents IA (Aminia / OCR)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=
XAI_API_KEY=
ELEVENLABS_API_KEY=

# E-mail transactionnel (si SMTP global)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=contact@mondomaine.fr

# Divers
SITE_BASE_URL=https://mondomaine.fr
