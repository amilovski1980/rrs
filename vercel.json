{
    "version": 2,
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "includeFiles": "config/**,admin_backoffice/**,companies/**,accounts/**,accounting/**,documents/**,ai/**,integrations/**,billing/**,core/**,static/**,requirements.txt"
        }
    },
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.py"
        }
    ]
}
