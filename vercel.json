{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "mkdir -p docs/assets && cp -f static/css/app.css docs/assets/app.css && cp -f static/js/app.js docs/assets/app.js && cp -f static/js/grok-voice.js docs/assets/grok-voice.js && cp -f static/img/logo.png static/img/logo-48.png static/img/logo-96.png static/img/logo-192.png docs/assets/",
  "outputDirectory": "docs",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "config/**,companies/**,accounts/**,accounting/**,documents/**,ai/**,integrations/**,billing/**,core/**,static/**,requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/cockpit",
      "destination": "/api/index"
    },
    {
      "source": "/cockpit/",
      "destination": "/api/index"
    },
    {
      "source": "/compte",
      "destination": "/api/index"
    },
    {
      "source": "/compte/",
      "destination": "/api/index"
    },
    {
      "source": "/compte/demo/",
      "destination": "/api/index"
    },
    {
      "source": "/compte/magic/",
      "destination": "/api/index"
    },
    {
      "source": "/compte/logout/",
      "destination": "/api/index"
    },
    {
      "source": "/compte/profil/",
      "destination": "/api/index"
    },
    {
      "source": "/compta",
      "destination": "/api/index"
    },
    {
      "source": "/compta/",
      "destination": "/api/index"
    },
    {
      "source": "/compta/grand-livre/",
      "destination": "/api/index"
    },
    {
      "source": "/compta/balance/",
      "destination": "/api/index"
    },
    {
      "source": "/compta/ecriture/nouvelle/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/nouvelle",
      "destination": "/api/index"
    },
    {
      "source": "/factures/nouvelle/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/modifier",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/modifier/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/emettre",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/emettre/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/payer",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/payer/",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk",
      "destination": "/api/index"
    },
    {
      "source": "/factures/:pk/",
      "destination": "/api/index"
    },
    {
      "source": "/ajouter",
      "destination": "/api/index"
    },
    {
      "source": "/ajouter/",
      "destination": "/api/index"
    },
    {
      "source": "/ajouter/confirmer",
      "destination": "/api/index"
    },
    {
      "source": "/ajouter/confirmer/",
      "destination": "/api/index"
    },
    {
      "source": "/compte/magic/:token",
      "destination": "/api/index"
    },
    {
      "source": "/compte/magic/:token/",
      "destination": "/api/index"
    },
    {
      "source": "/admin/",
      "destination": "/api/index"
    },
    {
      "source": "/agent-config",
      "destination": "/api/index"
    },
    {
      "source": "/agent/session/",
      "destination": "/api/index"
    },
    {
      "source": "/agent/outil/",
      "destination": "/api/index"
    },
    {
      "source": "/static/css/app.css",
      "destination": "/assets/app.css"
    },
    {
      "source": "/static/js/app.js",
      "destination": "/assets/app.js"
    },
    {
      "source": "/static/js/grok-voice.js",
      "destination": "/assets/grok-voice.js"
    },
    {
      "source": "/static/img/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
